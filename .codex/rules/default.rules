# Seeded by bootstrap.sh. Codex appends a rule here every time a command is
# approved "always", so bootstrap copies it only when the file is missing.
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "merge", "--ff-only"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add"], decision="allow")
prefix_rule(pattern=["git", "status", "-sb"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "test"], decision="allow")
prefix_rule(pattern=["npm", "audit"], decision="allow")
prefix_rule(pattern=["npm", "run", "typecheck"], decision="allow")
prefix_rule(pattern=["npm", "run", "test:e2e"], decision="allow")
prefix_rule(pattern=["python3", "-m", "http.server"], decision="allow")
prefix_rule(pattern=["pdfpal"], decision="allow")
prefix_rule(pattern=["saldo"], decision="allow")
